# JS FITNESS INC Environment Configuration (Supabase + Vercel)

# Server / Deployment
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173,https://jsfitness.ca,https://www.jsfitness.ca
COOKIE_SECURE=false

# Supabase PostgreSQL (Settings -> Database -> Connection string)
# Runtime queries on Vercel / Express: use Transaction Pooler (port 6543, pgbouncer=true)
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# Prisma schema push / migrations / direct queries: use Session Pooler or Direct connection (port 5432)
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase Project API Keys (Settings -> API)
SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
SUPABASE_ANON_KEY="<YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY>"
SUPABASE_SERVICE_ROLE_KEY="<YOUR_SUPABASE_SERVICE_ROLE_OR_SECRET_KEY>"
SUPABASE_STORAGE_BUCKET="media"

# Optional Frontend API Base Override (leave empty when deployed on a single Vercel project)
VITE_API_BASE_URL=

# Fallback JWT Secret (used only if Supabase Auth env vars are omitted in local offline mode)
JWT_SECRET=change-this-to-a-64-char-random-secret-in-production
JWT_EXPIRES_IN=7d

# Owner Admin Seed / Migration Credentials
ADMIN_EMAIL=admin@jsfitness.ca
ADMIN_PASSWORD=JSFitness2026!

# SMTP / Nodemailer (Contact Form -> coachingbyjatinder@gmail.com)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_RECIPIENT_EMAIL=coachingbyjatinder@gmail.com

# Optional default Calendly URLs (can also be overridden in /admin)
CALENDLY_TOUR_URL=
CALENDLY_ASSESSMENT_URL=

# Google Maps Embed API / Query
GOOGLE_MAPS_QUERY=Unit+3135,+6520+36+Street+NE,+Calgary,+AB+T3J+2L3
