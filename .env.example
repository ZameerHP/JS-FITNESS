# JS FITNESS INC Environment Configuration

# Server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
COOKIE_SECURE=false

# Database (SQLite for local dev; switch schema.prisma provider to postgresql for production)
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://jsfitness:strongpassword@postgres:5432/jsfitness?schema=public"

# JWT Auth
JWT_SECRET=change-this-to-a-64-char-random-secret-in-production
JWT_EXPIRES_IN=7d

# Owner Admin Seed Credentials
ADMIN_EMAIL=admin@jsfitness.ca
ADMIN_PASSWORD=JSFitness2026!

# SMTP / Nodemailer (Contact Form -> coachingbyjatinder@gmail.com)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_RECIPIENT_EMAIL=coachingbyjatinder@gmail.com

# Optional default Calendly URLs (can also be overridden in /admin)
CALENDLY_TOUR_URL=
CALENDLY_ASSESSMENT_URL=

# Google Maps Embed API / Query
GOOGLE_MAPS_QUERY=Unit+3135,+6520+36+Street+NE,+Calgary,+AB+T3J+2L3
