# JS FITNESS INC — Server Environment Template
# Copy to server/.env and fill with your Supabase project credentials.
# In production on Vercel, configure these same keys under Project Settings -> Environment Variables.

PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
COOKIE_SECURE=false

# Supabase PostgreSQL (Transaction Pooler port 6543 for runtime, Direct/Session port 5432 for Prisma push/migrations)
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase Project API Keys (Settings -> API)
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# Fallback JWT secret (only used if SUPABASE_* keys are empty locally)
JWT_SECRET=change-this-to-a-64-char-random-secret-in-production
JWT_EXPIRES_IN=7d

# Owner Admin Credentials
ADMIN_EMAIL=admin@jsfitness.ca
ADMIN_PASSWORD=JSFitness2026!

# SMTP / Nodemailer (Contact Form -> coachingbyjatinder@gmail.com)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_RECIPIENT_EMAIL=coachingbyjatinder@gmail.com

# Optional default Calendly URLs
CALENDLY_TOUR_URL=
CALENDLY_ASSESSMENT_URL=
