// Prisma Schema for JS FITNESS INC
// Local dev uses SQLite ("sqlite"). For production PostgreSQL, switch provider to "postgresql".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Transformation {
  id          String   @id @default(cuid())
  name        String
  timeframe   String
  category    String   @default("Fat Loss & Muscle")
  story       String   @default("")
  beforeImage String
  afterImage  String
  isDemo      Boolean  @default(false)
  visible     Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([visible, order])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("JS FITNESS Member")
  quote     String
  rating    Int      @default(5)
  avatarUrl String?
  visible   Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visible, order])
}

model GalleryItem {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  category  String   @default("Facility")
  visible   Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visible, order])
}

model VideoItem {
  id            String   @id @default(cuid())
  title         String
  url           String
  thumbnailUrl  String?
  isWalkthrough Boolean  @default(false)
  visible       Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([visible, order])
}

model Certification {
  id        String   @id @default(cuid())
  title     String
  issuer    String
  year      String   @default("")
  imageUrl  String?
  visible   Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visible, order])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String   @default("")
  interest  String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
