// Prisma Schema for JS FITNESS INC — Supabase PostgreSQL

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String   @map("password_hash")
  supabaseUserId String?  @unique @map("supabase_user_id")
  totpSecret     String?  @map("totp_secret")
  totpEnabled    Boolean  @default(false) @map("totp_enabled")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("admin_users")
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("site_settings")
}

model Transformation {
  id          String   @id @default(cuid())
  name        String
  timeframe   String
  category    String   @default("Fat Loss & Muscle")
  story       String   @default("")
  beforeImage String   @map("before_image")
  afterImage  String   @map("after_image")
  isDemo      Boolean  @default(false) @map("is_demo")
  visible     Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([visible, order])
  @@map("transformations")
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("JS FITNESS Member")
  quote     String
  rating    Int      @default(5)
  avatarUrl String?  @map("avatar_url")
  visible   Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([visible, order])
  @@map("testimonials")
}

model GalleryItem {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String   @map("image_url")
  category  String   @default("Facility")
  visible   Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([visible, order])
  @@map("gallery_items")
}

model VideoItem {
  id            String   @id @default(cuid())
  title         String
  url           String
  thumbnailUrl  String?  @map("thumbnail_url")
  isWalkthrough Boolean  @default(false) @map("is_walkthrough")
  visible       Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([visible, order])
  @@map("video_items")
}

model Certification {
  id        String   @id @default(cuid())
  title     String
  issuer    String
  year      String   @default("")
  imageUrl  String?  @map("image_url")
  visible   Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([visible, order])
  @@map("certifications")
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String   @default("")
  interest  String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([read, createdAt])
  @@map("contact_submissions")
}
